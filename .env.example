# Environment Variable Configuration Template
# Velyxora Enterprise Crypto Exchange

# 1. API Gateway Server Ports
PORT=8080
LOG_LEVEL=DEBUG
LOG_FORMAT=JSON

# 2. Cryptographic Security Key Rings
JWT_SECRET=super-secure-velyxora-key-999

# 3. PostgreSQL Database Connections
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=velyxora

# 4. Redis Caching Addresses
REDIS_ADDR=localhost:6379

# 5. Kafka Distributed Event Brokers
KAFKA_BROKERS=localhost:9092
