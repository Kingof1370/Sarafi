# ============================================
# VELYXORA GLOBAL EXCHANGE - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values
# DO NOT commit .env.local to repository!

# ============================================
# 1. APPLICATION CONFIG
# ============================================
APP_NAME=Velyxora
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_URL=https://velyxora.exchange
FRONTEND_URL=https://app.velyxora.exchange

# ============================================
# 2. SERVER CONFIG
# ============================================
PORT=8080
API_PORT=8080
FRONTEND_PORT=3000
WEBSOCKET_PORT=8081
GRPC_PORT=50051

# ============================================
# 3. DATABASE CONFIG (PostgreSQL)
# ============================================
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_USER=velyxora_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=velyxora_exchange
DB_SSL_MODE=require
DB_CONNECTION_POOL_MIN=10
DB_CONNECTION_POOL_MAX=50
DB_STATEMENT_TIMEOUT=30000

# ============================================
# 4. REDIS CONFIG (Caching & Sessions)
# ============================================
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS_ENABLED=true
REDIS_TIMEOUT=5000

# ============================================
# 5. KAFKA CONFIG (Event Streaming)
# ============================================
KAFKA_BROKERS=kafka-1.production.internal:9092,kafka-2.production.internal:9092,kafka-3.production.internal:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=velyxora-producer
KAFKA_SASL_PASSWORD=CHANGE_ME_KAFKA_PASSWORD
KAFKA_TLS_CA_CERT=/etc/ssl/certs/kafka-ca.pem
KAFKA_TLS_CERT=/etc/ssl/certs/kafka-client.pem
KAFKA_TLS_KEY=/etc/ssl/certs/kafka-client-key.pem

# ============================================
# 6. SECURITY & ENCRYPTION
# ============================================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_64_CHARS_REQUIRED_FOR_PRODUCTION
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_AES256_ENCRYPTION_KEY_64_HEX_CHARS
ENCRYPTION_ALGORITHM=AES-256-GCM
API_SIGNING_SECRET=CHANGE_ME_HMAC_SECRET_FOR_API_SIGNING

# ============================================
# 7. MFA & 2FA CONFIG
# ============================================
MFA_ISSUER=Velyxora
MFA_WINDOW_SIZE=30
MFA_DIGITS=6
MFA_ENABLED_BY_DEFAULT=true

# ============================================
# 8. RATE LIMITING & DDoS
# ============================================
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW=60s
RATE_LIMIT_BURST=500
RATE_LIMIT_ENABLED=true
DDOS_PROTECTION_ENABLED=true
DDOS_THRESHOLD=1000

# ============================================
# 9. MARKET DATA INTEGRATIONS
# ============================================
# Binance API
BINANCE_API_KEY=CHANGE_ME_BINANCE_API_KEY
BINANCE_API_SECRET=CHANGE_ME_BINANCE_API_SECRET
BINANCE_TESTNET_ENABLED=false
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws

# CoinGecko API (Free tier for market data)
COINGECKO_API_KEY=CHANGE_ME_COINGECKO_API_KEY
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# CoinMarketCap (Premium market data)
COINMARKETCAP_API_KEY=CHANGE_ME_COINMARKETCAP_API_KEY
COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com/v1

# Alpha Vantage (Forex & Stock data)
ALPHA_VANTAGE_API_KEY=CHANGE_ME_ALPHA_VANTAGE_KEY

# ============================================
# 10. PAYMENT GATEWAY INTEGRATIONS
# ============================================
# Stripe (Credit Card Processing)
STRIPE_PUBLIC_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# PayPal
PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_SECRET
PAYPAL_MODE=live

# Wise (International Transfers)
WISE_API_TOKEN=CHANGE_ME_WISE_API_TOKEN
WISE_PROFILE_ID=CHANGE_ME_WISE_PROFILE_ID

# Crypto Payment Processor (BitPay or Coinbase Commerce)
BITPAY_TOKEN=CHANGE_ME_BITPAY_TOKEN
COINBASE_COMMERCE_API_KEY=CHANGE_ME_COINBASE_API_KEY

# ============================================
# 11. KYC/AML INTEGRATIONS
# ============================================
# Onfido (Identity Verification)
ONFIDO_API_TOKEN=CHANGE_ME_ONFIDO_TOKEN
ONFIDO_WEBHOOK_TOKEN=CHANGE_ME_ONFIDO_WEBHOOK

# Sumsub (Advanced KYC)
SUMSUB_APP_TOKEN=CHANGE_ME_SUMSUB_TOKEN
SUMSUB_SECRET_KEY=CHANGE_ME_SUMSUB_SECRET

# Chainalysis (AML/Blockchain Monitoring)
CHAINALYSIS_API_KEY=CHANGE_ME_CHAINALYSIS_KEY
CHAINALYSIS_ENABLE_SANCTIONS_CHECK=true

# Refinitiv (Transaction Monitoring)
REFINITIV_API_KEY=CHANGE_ME_REFINITIV_KEY

# ============================================
# 12. CLOUD INFRASTRUCTURE
# ============================================
# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_S3_BUCKET=velyxora-data-production
AWS_KMS_KEY_ID=CHANGE_ME_AWS_KMS_KEY_ARN
AWS_SECRETS_MANAGER_REGION=us-east-1

# Google Cloud
GCP_PROJECT_ID=velyxora-production
GCP_SERVICE_ACCOUNT_KEY=/etc/secrets/gcp-service-account.json
GCS_BUCKET=velyxora-backups-gcs

# Azure
AZURE_SUBSCRIPTION_ID=CHANGE_ME_AZURE_SUB_ID
AZURE_RESOURCE_GROUP=velyxora-production
AZURE_KEYVAULT_URL=https://velyxora-kv.vault.azure.net/

# ============================================
# 13. LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
SENTRY_DSN=CHANGE_ME_SENTRY_DSN_FOR_ERROR_TRACKING
DATADOG_API_KEY=CHANGE_ME_DATADOG_API_KEY
DATADOG_APP_KEY=CHANGE_ME_DATADOG_APP_KEY

# ============================================
# 14. BLOCKCHAIN NETWORKS
# ============================================
# Ethereum
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/CHANGE_ME_ALCHEMY_KEY
ETH_WEBSOCKET_URL=wss://eth-mainnet.g.alchemy.com/v2/CHANGE_ME_ALCHEMY_KEY
ETH_CHAIN_ID=1

# Bitcoin
BTC_RPC_URL=https://mainnet.blockchain.info/q
BTC_WEBSOCKET_URL=wss://ws.blockchain.info/inv

# Binance Smart Chain (BSC)
BSC_RPC_URL=https://bsc-dataseed1.bnbchain.org:8545
BSC_CHAIN_ID=56

# Polygon (Matic)
POLYGON_RPC_URL=https://polygon-rpc.com/
POLYGON_CHAIN_ID=137

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WEBSOCKET_URL=wss://api.mainnet-beta.solana.com

# ============================================
# 15. EMAIL & NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
MAIL_FROM=noreply@velyxora.exchange
MAIL_FROM_NAME=Velyxora Exchange

# Twilio (SMS)
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_TOKEN
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# 16. BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY_64_HEX
BACKUP_SCHEDULE=0 2 * * * # 2 AM UTC daily
BACKUP_RETENTION_DAYS=90
BACKUP_S3_BUCKET=velyxora-backups
BACKUP_VERIFICATION_ENABLED=true

# ============================================
# 17. MULTI-REGION DEPLOYMENT
# ============================================
PRIMARY_REGION=us-east-1
SECONDARY_REGIONS=eu-west-1,ap-southeast-1
REGION_FAILOVER_ENABLED=true
HEALTH_CHECK_INTERVAL=30s

# ============================================
# 18. FEATURE FLAGS
# ============================================
FEATURE_MARGIN_TRADING=false
FEATURE_FUTURES_TRADING=false
FEATURE_STAKING=false
FEATURE_LENDING=false
FEATURE_DERIVATIVES=false
FEATURE_P2P_TRADING=true
FEATURE_OTC_DESK=false

# ============================================
# 19. COMPLIANCE & LEGAL
# ============================================
SUPPORTED_COUNTRIES=US,GB,DE,FR,JP,SG,HK,AE
RESTRICTED_COUNTRIES=IR,KP,SY,CU
AML_TRANSACTION_THRESHOLD=10000 # USD
KYC_VERIFICATION_REQUIRED=true
TERMS_OF_SERVICE_VERSION=1.0.0

# ============================================
# 20. TESTING & DEVELOPMENT
# ============================================
TEST_MODE=false
MOCK_MARKET_DATA=false
LOAD_TEST_ENABLED=false
DEBUG_LOGGING=false
